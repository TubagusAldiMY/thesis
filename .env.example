# Salin ke .env lalu isi nilainya. .env TIDAK boleh di-commit.
#   cp .env.example .env

# Password root MySQL untuk container docker-compose (buat acak, mis. `openssl rand -hex 16`).
MYSQL_ROOT_PASSWORD=ganti-dengan-password-acak
# Port MySQL di host (127.0.0.1 saja).
MYSQL_PORT=33070

# DSN aplikasi & migrasi (database `spkzakat`). Ganti PASSWORD dengan nilai di atas.
DATABASE_URL='root:PASSWORD@tcp(127.0.0.1:33070)/spkzakat'

# Kunci untuk NIK/No. HP mustahik (PII). Masing-masing 32 byte acak dalam base64:
#   openssl rand -base64 32
# JANGAN dipakai ulang antar keperluan, JANGAN hilang (data terenkripsi tidak bisa
# dibaca tanpa kunci yang sama), dan JANGAN di-commit.
NIK_ENCRYPTION_KEY=ganti-dengan-32-byte-acak-base64
NIK_HMAC_KEY=ganti-dengan-32-byte-acak-base64-yang-berbeda

# DSN untuk test integrasi: TANPA nama database. Tiap run membuat database
# sementara `spkzakat_test_<acak>` lalu menghapusnya. Kosong = test integrasi dilewati.
TEST_DATABASE_URL='root:PASSWORD@tcp(127.0.0.1:33070)/'

# ---- Server API (cmd/server) ----
# Alamat listen. Bawaan 127.0.0.1:8090 = hanya lokal (API dipanggil SvelteKit,
# tidak diekspos publik). Port 8080 sering dipakai aplikasi lain (mis. Jenkins).
ADDR=127.0.0.1:8090
# Flag Secure pada cookie sesi dari Go. false HANYA untuk development lewat
# curl/http://; production wajib true (atau hapus baris ini, bawaan true).
COOKIE_SECURE=false
# debug | info | warn | error (bawaan info)
LOG_LEVEL=info

# ---- Docker penuh (docker compose up -d --build) ----
# Port & alamat frontend di host. WEB_ORIGIN harus sama persis dengan alamat
# di browser. Bawaan 3101 (3100 sering dipakai Loki project lain).
# WEB_PORT=3101
# WEB_ORIGIN=http://localhost:3101
# DATABASE_URL di atas hanya untuk pemakaian dari host (go run, test);
# container api memakai DSN sendiri (host `mysql`) yang dirakit di docker-compose.yml.

# ---- Donasi online (opsional; kosongkan PAYMENT_PROVIDER = halaman /donasi nonaktif) ----
# Halaman publik /donasi dibayar lewat payment gateway. Pencatatan donasi tunai/transfer
# oleh petugas (menu Donasi) tetap berfungsi tanpa pengaturan ini.
#   (kosong) = nonaktif | midtrans = Midtrans Snap | tiruan = pembayaran PALSU untuk dev/demo
#   "tiruan" menolak menyala bila COOKIE_SECURE bukan false (supaya tidak terbawa ke production).
# PAYMENT_PROVIDER=
# Server Key dari dashboard Midtrans (sandbox dulu). RAHASIA: jangan di-commit, jangan dilog.
# MIDTRANS_SERVER_KEY=
# Client Key dari dashboard Midtrans (Access Keys → General Credentials). Bukan rahasia.
# Diisi = pembayaran muncul sebagai popup di halaman donasi; kosong = muzaki dialihkan ke
# halaman bayar Midtrans. Jalan dengan `npm run dev`: isi juga di frontend/.env.
# PUBLIC_MIDTRANS_CLIENT_KEY=
# Alamat Snap. Kosong = sandbox (https://app.sandbox.midtrans.com/snap/v1/transactions).
# Untuk production isi alamat Snap production dari dokumentasi Midtrans.
# MIDTRANS_SNAP_URL=
# Alamat publik frontend (tujuan pengalihan setelah bayar). Wajib bila PAYMENT_PROVIDER aktif;
# harus sama dengan WEB_ORIGIN/ORIGIN frontend dan berawalan http:// atau https://.
# WEB_ORIGIN=http://localhost:3101

# ---- Email ke Ketua saat ada donasi online diterima (opsional) ----
# Tiap donasi web yang berubah menjadi "diterima" mengirim satu email ke Ketua (nama donatur,
# jenis, jumlah, nomor kuitansi, tautan detail; tanpa No. HP). SMTP_HOST dan NOTIF_EMAIL_KETUA
# harus diisi bersamaan; keduanya kosong = tanpa email. Bila email gagal terkirim, donasi tetap
# tersimpan dan kegagalan hanya dicatat di log Go.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=alamat Gmail pengirim, SMTP_PASSWORD="App password"
# (akun Google dengan verifikasi 2 langkah), BUKAN password login. SMTP_PASSWORD RAHASIA: jangan di-commit.
# SMTP_HOST=
# 587 = STARTTLS (bawaan), 465 = TLS langsung.
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Kosong = sama dengan SMTP_USER.
# SMTP_FROM=
# NOTIF_EMAIL_KETUA=

# Password akun demo lokal (admin & ketua), dipakai scripts/seed-demo.sh.
# Buat acak: openssl rand -hex 12. Jangan dipakai di production.
DEMO_PASSWORD=ganti-dengan-password-demo-acak

# Salin ke frontend/.env (untuk `npm run dev`) atau set sebagai environment
# variable proses Node saat production. frontend/.env TIDAK di-commit.

# Alamat Go API (server-ke-server; browser tidak pernah memanggilnya langsung).
API_URL=http://127.0.0.1:8090

# Identitas masjid untuk sidebar, landing, dan kop laporan.
PUBLIC_MASJID_NAMA=Masjid Jami Al-Barokah
PUBLIC_MASJID_ALAMAT=Jl. Ampera Poncol, Babakan, Kec. Setu, Kota Tangerang Selatan, Banten 15315
# Kosong = baris kontak tidak ditampilkan. Isi nomor/email pengurus bila sudah ada.
PUBLIC_MASJID_KONTAK=
# Logo masjid (opsional). Bawaan: /logo-masjid.jpg (lambang Masjid Jami' Al-Barokah, sudah ada di
# frontend/static/). Untuk masjid lain, ganti berkas itu atau taruh gambar baru di frontend/static/ lalu
# isi alamatnya. Gambar persegi paling pas; perlu build ulang bila pakai Docker.
# PUBLIC_MASJID_LOGO=/logo-masjid.jpg
# Foto masjid untuk latar hero landing (opsional): taruh di frontend/static/, mis. /foto-masjid.jpg.
# Kosong = latar hijau tua berpola. Foto otomatis digelapkan supaya teks tetap terbaca.
# PUBLIC_MASJID_FOTO=/foto-masjid.jpg
# Koordinat masjid untuk jadwal salat (derajat desimal; lintang selatan negatif). Bawaan bila kosong =
# Pamulang, Tangerang Selatan. Di bawah ini titik Jl. Ampera Poncol, Setu; selisih 1° bujur ≈ 4 menit.
PUBLIC_MASJID_LINTANG=-6.3504350
PUBLIC_MASJID_BUJUR=106.6922278

# ---- Hanya production (`node build`) ----
# ORIGIN wajib = alamat publik aplikasi (dipakai cek CSRF form action).
# ORIGIN=https://zakat.masjid-contoh.id
# PORT=3000
# Bila di belakang reverse proxy (nginx/caddy), supaya IP asli pengguna
# terbaca untuk penguncian login & audit:
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
